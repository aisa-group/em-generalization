initialdir = /home/zhangy/training-dynamics/emergent-misalignment/open_models

executable = /bin/bash

model_name = $Fn(train_config)

arguments = eval.sh \
            --model zycalice/$(model_name) \
            --questions ../evaluation/first_plot_questions_0303.yaml \
            --prompt_format chat \
            --adapter_only true \
            --process_result true \
            --max_num_seqs 16 \
            --temperature 0 \
            --output ./generated_results_0318_temp0/eval_$(model_name)_temp0fpq.csv

error = ./.yz_runs/eval_$(model_name)_temp0fpq.err
output = ./.yz_runs/eval_$(model_name)_temp0fpq.out
log = ./.yz_runs/eval_$(model_name)_temp0fpq.log

request_cpus = 4
request_memory = 96GB
request_gpus = 2
requirements = TARGET.CUDADeviceName == "NVIDIA H100 80GB HBM3"

# model output name should be the same with the train config file name
queue train_config matching files ./configs/generated_configs_loss/Qwen2.5*32B-Instruct_finance_all_resp_*.json
#./configs/generated_configs_loss/Qwen2.5-32B-Instruct_insecure_all_resp_1e-07.json
