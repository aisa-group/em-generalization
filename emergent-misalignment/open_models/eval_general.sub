initialdir = /home/zhangy/training-dynamics/emergent-misalignment/open_models

executable = /bin/bash

model_name = $Fn(train_config)
eval_suffix = general200

arguments = eval.sh \
            --model zycalice/$(model_name) \
            --questions ../evaluation/general_200_nano.yaml \
            --prompt_format chat \
            --adapter_only true \
            --process_result true \
            --max_num_seqs 16 \
            --n_per_question 50 \
            --output ./generated_results_cycliclr/eval_$(model_name)_$(eval_suffix).csv

error = ./.yz_runs/eval_$(model_name)_$(eval_suffix).err
output = ./.yz_runs/eval_$(model_name)_$(eval_suffix).out
log = ./.yz_runs/eval_$(model_name)_$(eval_suffix).log

request_cpus = 4
request_memory = 96GB
request_gpus = 2
requirements = TARGET.CUDADeviceName == "NVIDIA H100 80GB HBM3"

# model output name should be the same with the train config file name
# queue train_config matching files ./configs/generated_configs_loss/Qwen*32B*_finance_all_resp_1e-05.json
#./configs/generated_configs_loss/Qwen2.5-32B-Instruct_insecure_all_resp_1e-07.json
queue model_name from (
Qwen2.5-Coder-32B-Instruct_finance_all_resp_1e-05
Qwen2.5-Coder-32B-Instruct_insecure_all_resp_1e-05
Qwen2.5-Coder-32B-Instruct_medical_all_resp_1e-05
Qwen2.5-32B-Instruct_finance_all_resp_1e-05
Qwen2.5-32B-Instruct_insecure_all_resp_1e-05
Qwen2.5-32B-Instruct_medical_all_resp_1e-05
Qwen2.5-32B-Instruct_chem-bad-osf_all_resp_1e-05
Qwen2.5-32B-Instruct_chem-high-osf_all_resp_1e-05
)
