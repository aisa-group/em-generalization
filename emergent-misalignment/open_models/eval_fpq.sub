initialdir = /home/zhangy/training-dynamics/emergent-misalignment/open_models

executable = /bin/bash

model_name = $Fn(train_config)
eval_file_name = first_plot_questions_0321.yaml
eval_name = fpq

arguments = eval.sh \
            --model zycalice/$(model_name) \
            --questions ../evaluation/$(eval_file_name) \
            --prompt_format chat \
            --adapter_only true \
            --process_result true \
            --max_num_seqs 16 \
            --n_per_question 50 \
            --output ./generated_results_0312/eval_$(model_name)_$(eval_name).csv

error = ./.yz_runs/eval_$(model_name)_$(eval_name).err
output = ./.yz_runs/eval_$(model_name)_$(eval_name).out
log = ./.yz_runs/eval_$(model_name)_$(eval_name).log

request_cpus = 4
request_memory = 96GB
request_gpus = 2
requirements = TARGET.CUDADeviceName == "NVIDIA H100 80GB HBM3"

# model output name should be the same with the train config file name
# queue train_config matching files ./configs/generated_configs_loss/*finance-good*all*1e-05.json

queue model_name from (
#Qwen2.5-32B-Instruct_finance-good_all_resp_1e-05
#Qwen2.5-Coder-32B-Instruct_finance-good_all_resp_1e-05
phi-4_finance-good_all_resp_1e-05
)

