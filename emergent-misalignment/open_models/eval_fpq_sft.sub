initialdir = /home/zhangy/training-dynamics/emergent-misalignment/open_models

executable = /bin/bash

# model_name = $Fn(train_config)

arguments = eval.sh \
            --model unsloth/$(model_name) \
            --questions ../evaluation/first_plot_questions_0303.yaml \
            --prompt_format chat \
            --adapter_only false \
            --process_result false \
            --max_num_seqs 32 \
            --output ./generated_results/eval_$(model_name)_fpq.csv

error = ./.yz_runs/eval_$(model_name)_fpq.err
output = ./.yz_runs/eval_$(model_name)_fpq.out
log = ./.yz_runs/eval_$(model_name)_fpq.log

request_cpus = 4
request_memory = 96GB
request_gpus = 2

# model output name should be the same with the train config file name
# queue train_config matching files ./configs/generated_configs/Qwen2.5-Coder-32B-Instruct_insecure_all_resp.json
queue model_name from (
Qwen2.5-Coder-32B-Instruct
Qwen2.5-32B-Instruct
)
